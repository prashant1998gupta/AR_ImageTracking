RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]


# Redirect all API requests to router
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/index.php?path=$1 [QSA,L]

# Allow direct access to tracker JS
RewriteRule ^tracker/ - [L]

# Allow direct access to dashboard and admin
RewriteRule ^dashboard/ - [L]
RewriteRule ^admin/ - [L]

# Allow direct access to meme hunt pages
RewriteRule ^hunt/ - [L]

# Security: block access to config and helpers
RewriteRule ^api/config\.php$ - [F,L]
RewriteRule ^api/helpers/ - [F,L]
RewriteRule ^sql/ - [F,L]
